% === provenance: Spadini2019 ===
% CLAIM: Hand-written mocks can diverge from the real dependency: developers find keeping a mock's
%   behaviour compatible with the real class hard, and production changes force mock changes.
% FOUND-VIA: scholar search '("mock objects" OR mocking OR "test doubles" OR stubs) AND ("unit test"
%   OR "unit testing" OR "software testing" OR "test code") AND (evolution OR "co-evolution" OR
%   maintenance OR inconsistency OR outdated)' -n t-mocks-diverge -p dblp -p ieee -p openalex -p
%   arxiv -l 20 -f bibtex+prov (session t-mocks-diverge, query S1); also returned by
%   t-interaction-brittle/C1/plain, t-interaction-brittle/S1/plain,
%   t-mocks-diverge/S0-superseded/plain, t-mocks-diverge/S1/scopus, t-mocks-diverge/S1/wos,
%   t-verified-fakes/C1/plain, t-verified-fakes/S1/plain
% PICKED: Primary mixed-methods study (2,000+ mock usages, 4 systems, 105-developer survey,
%   mock-evolution history); journal extension of Spadini et al. 2017, the starting point named in
%   the brief.
% QUOTE (p. 1479, 'Unstable dependencies'): "A problem when using mocks is maintaining the behavior of
%   the mock compatible with the behavior of the original class, especially when the original class
%   is poorly designed or highly coupled. As the production class tends to change often, the mock
%   object becomes unstable and, as a consequence, more prone to change."
% VERIFIED: full-text (Springer PDF via KTH tunnel); applies at 'can diverge' strength:
%   developer-reported challenge confirmed by mock-change data (p. 1482: 51% of mock changes induced
%   by production code); it does not measure tests passing while integration breaks.
% COUNTER: session t-mocks-diverge, query C1 (same mock/test-double + unit-testing terms AND
%   benefits/advantages/effectiveness/'test isolation') on ieee+openalex+arxiv+wos+scopus (dblp
%   failed): surfaced mocking-usage and mock-generation studies and Zhu et al. 2025 (mock assertions
%   add fault detection), none showing that mocks stay in sync with the real dependency; claim
%   narrowed to 'can diverge' (developer-reported challenge plus one seeded-defect case study), not
%   'usually diverge'.
% DATE: 2026-10-12
@article{Spadini2019,
  title = {Mock objects for testing java systems: Why and how developers use them, and how they evolve},
  volume = {24},
  issn = {1573-7616},
  url = {http://dx.doi.org/10.1007/s10664-018-9663-0},
  doi = {10.1007/s10664-018-9663-0},
  number = {3},
  journal = {Empirical Software Engineering},
  publisher = {Springer Science and Business Media LLC},
  author = {Spadini, Davide and Aniche, Maurício and Bruntink, Magiel and Bacchelli, Alberto},
  year = {2019},
  month = Nov,
  pages = {1461–1498}
}

